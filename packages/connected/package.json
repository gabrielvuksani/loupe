{
  "name": "loupe-cli",
  "version": "0.1.10",
  "type": "module",
  "description": "loupe: deterministic design and accessibility detection with a real-browser render loop, exposed as an MCP server and WebSocket bridge for your CLI agent.",
  "keywords": ["design", "accessibility", "a11y", "mcp", "playwright", "lighthouse", "axe", "design-qa", "lens"],
  "homepage": "https://github.com/gabrielvuksani/loupe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvuksani/loupe.git",
    "directory": "packages/connected"
  },
  "license": "MIT",
  "bin": {
    "loupe": "./dist/bin.js",
    "loupe-cli": "./dist/bin.js",
    "loupe-connected": "./dist/bin.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "mcp": "tsx src/bin.ts --mcp",
    "bridge": "tsx src/bin.ts --bridge",
    "serve": "tsx src/bin.ts --serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@mdn/browser-compat-data": "^8.0.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@projectwallace/css-analyzer": "^9.9.0",
    "browserslist": "^4.28.2",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.3.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@loupe/engine": "workspace:*",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2"
  }
}
