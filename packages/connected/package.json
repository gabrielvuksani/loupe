{
  "name": "@goldeye/connected",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "goldeye connected engine. MCP server and WebSocket bridge. Real Playwright render, axe-core, and Lighthouse, working out of the box.",
  "bin": {
    "goldeye-connected": "./src/bin.ts"
  },
  "scripts": {
    "test": "vitest run",
    "mcp": "tsx src/bin.ts --mcp",
    "bridge": "tsx src/bin.ts --bridge",
    "serve": "tsx src/bin.ts --serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@goldeye/engine": "workspace:*",
    "@mdn/browser-compat-data": "^8.0.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@projectwallace/css-analyzer": "^9.9.0",
    "browserslist": "^4.28.2",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.3.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
